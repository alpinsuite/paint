[Desktop Entry]
Type=Application
# Desktop Entry Specification version this file conforms to — not the
# application's version. 1.1 is the newest that desktop-file-validate on
# Ubuntu 22.04 recognises, and it covers every key used below; declaring a
# later spec makes the validator reject the file outright.
Version=1.1
Name=Paint
GenericName=Image Editor
Comment=A simple, easy-to-use image editor
Exec=paint %f
TryExec=paint
Icon=io.github.rbuache.Paint
Terminal=false
StartupNotify=true
StartupWMClass=paint
Categories=Graphics;2DGraphics;RasterGraphics;
Keywords=paint;draw;drawing;image;picture;photo;editor;bitmap;canvas;sketch;
MimeType=image/png;image/jpeg;image/bmp;image/gif;image/tiff;image/webp;image/x-tga;image/vnd.microsoft.icon;image/vnd.adobe.photoshop;image/x-portable-anymap;image/x-portable-bitmap;image/x-portable-graymap;image/x-portable-pixmap;
